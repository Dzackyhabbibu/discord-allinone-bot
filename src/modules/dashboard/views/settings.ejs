<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings</title>
  <link rel="stylesheet" href="/dashboard/public/main.css">
  <style>
    .settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 700px) { .settings-grid { grid-template-columns: 1fr; } }
    .setting-card { background: #1e1f22; border: 1px solid #30363d; border-radius: 8px; padding: 1.5rem; }
    .setting-card h2 { font-size: 1.1rem; margin-bottom: 1rem; }
    .toggle-group { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid #30363d; }
    .toggle-group:last-child { border-bottom: none; }
    .toggle-group label { font-weight: 500; }
    .toggle-group .desc { font-size: 0.8rem; color: #b9c0c7; }
    .btn-submit { margin-top: 1.5rem; padding: 0.75rem 1.5rem; background: #5865F2; color: #fff; border: none; border-radius: 5px; font-weight: 500; cursor: pointer; }
    .btn-submit:hover { background: #4752c4; }

    .back-link { display: inline-block; margin-bottom: 1rem; color: #5865F2; }
    .back-link:hover { text-decoration: none; }
  </style>
</head>
<body>
  <div class="main-content">
    <a href="/guilds" class="back-link">← Back to Servers</a>
    <div class="page-header">
      <h1>⚙️ Server Settings</h1>
      <a href="/" class="btn btn-outline btn-sm">← Dashboard</a>
    </div>

    <div class="settings-grid">
      <!-- General -->
      <div class="setting-card">
        <h2>General</h2>
        <form action="/guild/<%= guild.guild_id %>/settings" method="POST">
          <div class="form-group">
            <label>Server Name</label>
            <input type="text" value="<%= guild.name || 'Not set' %>" disabled>
          </div>
          <div class="form-group">
            <label>Prefix</label>
            <input type="text" name="prefix" value="<%= guild.prefix || '!' %>">
          </div>
          <div class="form-group">
            <label>Language</label>
            <select name="language">
              <option value="en" <%= (guild.language || 'en') === 'en' ? 'selected' : '' %>>English</option>
              <option value="tr" <%= (guild.language || 'en') === 'tr' ? 'selected' : '' %>>Turkish</option>
              <option value="ru" <%= (guild.language || 'en') === 'ru' ? 'selected' : '' %>>Russian</option>
            </select>
          </div>
          <div class="form-group">
            <label>Timezone</label>
            <input type="text" name="timezone" value="<%= guild.timezone || 'UTC' %>" placeholder="UTC">
          </div>
          <button type="submit" class="btn btn-submit">Save</button>
        </form>
      </div>

      <!-- Channels -->
      <div class="setting-card">
        <h2>Channels</h2>
        <form action="/guild/<%= guild.guild_id %>/settings" method="POST">
          <div class="form-group">
            <label>Music Channel</label>
            <select name="music_channel">
              <option value="">None</option>
              <% guild.channels ? guild.channels.forEach(ch => { %>
                <option value="<%= ch %>" <%= (guild.music_channel || '') === ch ? 'selected' : '' %>>#<%= ch %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Mod Log Channel</label>
            <select name="log_channel">
              <option value="">None</option>
              <% guild.channels ? guild.channels.forEach(ch => { %>
                <option value="<%= ch %>" <%= (guild.log_channel || '') === ch ? 'selected' : '' %>>#<%= ch %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Welcome Channel</label>
            <select name="welcome_channel">
              <option value="">None</option>
              <% guild.channels ? guild.channels.forEach(ch => { %>
                <option value="<%= ch %>" <%= (guild.welcome_channel || '') === ch ? 'selected' : '' %>>#<%= ch %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-submit">Save</button>
        </form>
      </div>

      <!-- Security -->
      <div class="setting-card">
        <h2>Security</h2>
        <form action="/guild/<%= guild.guild_id %>/settings" method="POST">
          <div class="toggle-group">
            <label>Anti-Nuke Protection</label>
            <label class="toggle">
              <input type="checkbox" name="anti_nuke_whitelist" value="" <%= (guild.anti_nuke_whitelist || '') === '' ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          <div class="toggle-group">
            <label>Auto Mod (Anti-Spam, Filters)</label>
            <label class="toggle">
              <input type="checkbox" name="autofilter_enabled" value="" <%= (guild.autofilter_enabled || false) === true ? 'checked' : '' %>>
              <span class="slider"></span>
            </label>
          </div>
          <div class="form-group">
            <label>Filtered Words (comma-separated)</label>
            <input type="text" name="filter_words" value="<%= guild.filter_words || '' %>" placeholder="bad, spam, link, test">
            <p class="text-muted" style="font-size:0.8rem;margin-top:0.25rem;">Comma-separated list of words to auto-filter in messages.</p>
          </div>
          <button type="submit" class="btn btn-submit">Save</button>
        </form>
      </div>

      <!-- Message Templates -->
      <div class="setting-card">
        <h2>Message Templates</h2>
        <form action="/guild/<%= guild.guild_id %>/settings" method="POST">
          <div class="form-group">
            <label>Welcome Message</label>
            <textarea name="welcome_message" rows="3" placeholder="Welcome {user} to {server}! 🎉"><%= guild.welcome_message || '' %></textarea>
          </div>
          <div class="form-group">
            <label>Goodbye Message</label>
            <textarea name="goodbye_message" rows="3" placeholder="Goodbye {user}! Hope to see you soon."><%= guild.goodbye_message || '' %></textarea>
          </div>
          <div class="form-group">
            <label>Autorole ID</label>
            <input type="text" name="autorole_role" value="<%= guild.autorole_role || '' %>" placeholder="Role ID">
          </div>
          <button type="submit" class="btn btn-submit">Save</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>