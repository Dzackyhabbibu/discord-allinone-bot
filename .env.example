# ── BOT ──────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=                     # opsional: kosong = global deploy (lebih lambat)
BOT_PREFIX=!

# ── DASHBOARD ────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=replace_with_random_string
CLIENT_SECRET=your_oauth2_client_secret_here

# ── MUSIK ────────────────────────────────────────────
# kosongkan jika tidak pakai Lavalink
LAVALINK_HOST=
LAVALINK_PASS=

# ── UMUM ─────────────────────────────────────────────
LOG_LEVEL=info
# path file sqlite
DB_PATH=data/bot.sqlite